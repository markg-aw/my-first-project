      rating: 4.9, reviews: 487, reviewList: [],
      img: 'https://images.unsplash.com/photo-1593618998160-e34014e67546?w=500&q=80&auto=format&fit=crop' },
    { id: 8, name: 'Laundry Basket', desc: 'Foldable, 40L', price: 299, category: 'storage', badge: '',
      rating: 4.4, reviews: 78, reviewList: [],
      img: 'https://images.unsplash.com/photo-1626806787461-102c1bfaaea1?w=500&q=80&auto=format&fit=crop' },
    { id: 9, name: 'Wall Clock', desc: 'Silent sweep, 12 inch', price: 399, oldPrice: 599, category: 'appliance', badge: 'flash', flash: true,
      rating: 4.6, reviews: 123, reviewList: [],
      img: 'https://images.unsplash.com/photo-1563861826100-9cb868fdbe1c?w=500&q=80&auto=format&fit=crop' },
    { id: 10, name: 'Rice Cooker', desc: '1.8L non-stick', price: 1099, category: 'kitchen', badge: '',
      rating: 4.8, reviews: 298, reviewList: [],
      img: 'https://images.unsplash.com/photo-1512058564366-18510be2db19?w=500&q=80&auto=format&fit=crop' },
    { id: 11, name: 'Dish Rack', desc: '2-tier stainless', price: 549, category: 'kitchen', badge: '',
      rating: 4.7, reviews: 187, reviewList: [],
      img: 'https://images.unsplash.com/photo-1584346133934-a3afd2a33c4c?w=500&q=80&auto=format&fit=crop' },
    { id: 12, name: 'Air Freshener', desc: 'Lavender, 300ml', price: 149, oldPrice: 249, category: 'cleaning', badge: 'flash', flash: true,
      rating: 4.5, reviews: 156, reviewList: [],
      img: 'https://images.unsplash.com/photo-1585771724684-38269d6639fd?w=500&q=80&auto=format&fit=crop' }
  ];

  const bestSellers = [...products].sort((a, b) => b.reviews - a.reviews).slice(0, 4);
  const flashProducts = products.filter(p => p.flash);

  let cart = [];
  let wishlist = JSON.parse(localStorage.getItem('havenlyWishlist') || '[]');
  let currentCategory = 'all';

  function renderStars(rating, size = '0.85rem') {
    let stars = '';
    for (let i = 1; i <= 5; i++) {
      if (i <= Math.floor(rating)) stars += '★';
      else if (i === Math.ceil(rating) && rating % 1 >= 0.3) stars += '★';
      else stars += '<span class="empty">★</span>';
    }
    return `<span class="stars-display" style="font-size:${size}">${stars}</span>`;
  }

  function productCard(p) {
    const discount = p.oldPrice ? Math.round((1 - p.price / p.oldPrice) * 100) : 0;
    const inWishlist = wishlist.includes(p.id);
    return `
      <div class="product">
        ${p.badge === 'flash' ? '<span class="product-badge flash">⚡ Flash</span>' : ''}
        ${discount > 0 ? `<span class="discount-tag ${p.badge === 'flash' ? 'with-badge' : ''}">-${discount}%</span>` : ''}
        <button class="wishlist-btn ${inWishlist ? 'active' : ''}" onclick="event.stopPropagation(); toggleWishlist(${p.id})" title="${inWishlist ? 'Remove from wishlist' : 'Add to wishlist'}"></button>
        <div class="product-img-wrap" onclick="openModal(${p.id})">
          <img class="product-img" src="${p.img}" alt="${p.name}" loading="lazy"
               onerror="this.style.display='none';this.parentElement.innerHTML='<div style=\\'display:flex;align-items:center;justify-content:center;height:100%;font-size:3rem;\\'>📦</div>'">
        </div>
        <div class="product-info">
          <div class="product-name" onclick="openModal(${p.id})">${p.name}</div>
          <div class="product-desc">${p.desc}</div>
          <div class="product-rating">
            ${renderStars(p.rating)}
            <span class="rating-count">${p.rating} (${p.reviews})</span>
          </div>
          <div class="product-bottom">
            <div class="price-block">
              <div class="product-price">₱${p.price.toLocaleString()}</div>
              ${p.oldPrice ? `<div class="old-price">₱${p.oldPrice.toLocaleString()}</div>` : ''}
            </div>
            <button class="add-btn" onclick="event.stopPropagation(); addToCart(${p.id})" title="Add to cart">+</button>
          </div>
        </div>
      </div>
    `;
  }

  function renderProducts() {
    const list = document.getElementById('productList');
    const filtered = currentCategory === 'all' ? products : products.filter(p => p.category === currentCategory);
    list.innerHTML = filtered.map(productCard).join('');
    observeNew(list);
  }

  function renderFlash() {
    const el = document.getElementById('flashProducts');
    el.innerHTML = flashProducts.map(productCard).join('');
    observeNew(el);
  }

  function renderBestsellers() {
    const el = document.getElementById('bestSellerProducts');
    el.innerHTML = bestSellers.map(productCard).join('');
    observeNew(el);
  }

  function renderWishlistPanel() {
    const el = document.getElementById('wishlistItems');
    const items = products.filter(p => wishlist.includes(p.id));

    if (items.length === 0) {
      el.innerHTML = `<div class="panel-empty"><div class="panel-empty-icon">🤍</div><p>Your wishlist is empty.</p></div>`;
    } else {
      el.innerHTML = items.map(item => `
        <div class="panel-item">
          <img class="panel-item-img" src="${item.img}" alt="${item.name}" onerror="this.style.display='none'">
          <div class="panel-item-info">
            <div class="panel-item-name">${item.name}</div>
            <div class="panel-item-price">₱${item.price.toLocaleString()}</div>
            <button class="wishlist-add-btn" onclick="addToCart(${item.id}); showToast('Added to cart');">+ Add to Cart</button>
          </div>
          <button class="remove-btn" onclick="toggleWishlist(${item.id})">✕</button>
        </div>
      `).join('');
    }

    const badge = document.getElementById('wishlistCount');
    badge.textContent = wishlist.length;
    badge.setAttribute('data-count', wishlist.length);
  }

  function refreshAll() {
    renderFlash();
    renderBestsellers();
    renderProducts();
    renderWishlistPanel();
  }

  function observeNew(parent) {
    parent.querySelectorAll('.product').forEach(el => {
      el.classList.add('reveal');
      observer.observe(el);
    });
  }

  function toggleWishlist(id) {
    const idx = wishlist.indexOf(id);
    const product = products.find(p => p.id === id);
    if (idx > -1) {
      wishlist.splice(idx, 1);
      showToast(`🤍 Removed from wishlist`);
    } else {
      wishlist.push(id);
      showToast(`❤️ ${product.name} saved`);
    }
    localStorage.setItem('havenlyWishlist', JSON.stringify(wishlist));
    refreshAll(); 
    if(document.getElementById('productModal').classList.contains('active')) {
        const isWish = wishlist.includes(id);
        const btn = document.querySelector('.modal-wish-btn');
        if(btn) {
            btn.classList.toggle('active', isWish);
            btn.innerHTML = isWish ? '❤️' : '🤍';
        }
    }
  }

  function openWishlist() {
    document.getElementById('wishlistOverlay').classList.add('active');
    document.getElementById('wishlistPanel').classList.add('active');
    document.body.style.overflow = 'hidden';
  }
  function closeWishlist() {
    document.getElementById('wishlistOverlay').classList.remove('active');
    document.getElementById('wishlistPanel').classList.remove('active');
    if(!document.getElementById('modalOverlay').classList.contains('active') && !document.getElementById('cartPanel').classList.contains('active')) {
        document.body.style.overflow = '';
    }
  }

  function openModal(id) {
    const p = products.find(x => x.id === id);
    if (!p) return;

    const discount = p.oldPrice ? Math.round((1 - p.price / p.oldPrice) * 100) : 0;
    const inWishlist = wishlist.includes(p.id);

    const ratingDist = { 5: 0, 4: 0, 3: 0, 2: 0, 1: 0 };
    const total = p.reviews;
    ratingDist[5] = Math.round(total * (p.rating >= 4.7 ? 0.75 : 0.55));
    ratingDist[4] = Math.round(total * (p.rating >= 4.7 ? 0.18 : 0.3));
    ratingDist[3] = Math.round(total * 0.08);
    ratingDist[2] = Math.round(total * 0.03);
    ratingDist[1] = total - ratingDist[5] - ratingDist[4] - ratingDist[3] - ratingDist[2];

    const reviewList = p.reviewList || [];
    const reviewsHTML = reviewList.map(r => `
      <div class="review-item">
        <div class="review-header">
          <div class="review-avatar">${r.name.split(' ').map(n => n[0]).join('').slice(0,2)}</div>
          <div class="review-author">${r.name}</div>
          <div class="review-date">${r.date}</div>
        </div>
        <div class="review-stars">${'★'.repeat(r.rating)}${'☆'.repeat(5 - r.rating)}</div>
        <div class="review-text">${r.text}</div>
      </div>
    `).join('');

    const barsHTML = [5,4,3,2,1].map(n => {
      const pct = total > 0 ? Math.round((ratingDist[n] / total) * 100) : 0;
      return `
        <div class="review-bar-row">
          <div class="review-bar-label">${n}★</div>
          <div class="review-bar-track"><div class="review-bar-fill" style="width:${pct}%"></div></div>
          <div class="review-bar-count">${ratingDist[n]}</div>
        </div>
      `;
    }).join('');

    document.getElementById('modalBody').innerHTML = `
      <div class="modal-image-wrap">
        <img class="modal-image" src="${p.img}" alt="${p.name}"
             onerror="this.style.display='none';this.parentElement.innerHTML='<div style=\\'display:flex;align-items:center;justify-content:center;height:100%;font-size:5rem;\\'>📦</div>'">
      </div>
      <div class="modal-info">
        <div class="modal-category">${p.category}</div>
        <h2 class="modal-name">${p.name}</h2>
        <p class="modal-desc">${p.desc}</p>

        <div class="modal-rating-row">
          ${renderStars(p.rating, '1.1rem')}
          <span class="modal-rating-num">${p.rating}</span>
          <span class="modal-rating-count">(${p.reviews} reviews)</span>
        </div>

        <div class="modal-price-row">
          <div class="modal-price">₱${p.price.toLocaleString()}</div>
          ${p.oldPrice ? `<div class="modal-old-price">₱${p.oldPrice.toLocaleString()}</div>` : ''}
          ${discount > 0 ? `<span class="modal-discount-badge">-${discount}% OFF</span>` : ''}
        </div>

        <div class="modal-actions">
          <button class="modal-add-btn" onclick="addToCart(${p.id}); closeModal();">🛒 Add to Cart</button>
          <button class="modal-wish-btn ${inWishlist ? 'active' : ''}" onclick="toggleWishlist(${p.id})" title="Wishlist">
            ${inWishlist ? '❤️' : '🤍'}
          </button>
        </div>

        <div class="modal-reviews-title">Customer Reviews</div>
        <div class="review-breakdown">
          <div class="review-score-block">
            <div class="review-score-big">${p.rating}</div>
            <div class="review-score-stars">${renderStars(p.rating, '0.9rem')}</div>
            <div class="review-score-count">${p.reviews} reviews</div>
          </div>
          <div class="review-bars">${barsHTML}</div>
        </div>

        ${reviewsHTML}
      </div>
    `;

    document.getElementById('modalOverlay').classList.add('active');
    document.getElementById('productModal').classList.add('active');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    document.getElementById('modalOverlay').classList.remove('active');
    document.getElementById('productModal').classList.remove('active');
    if(!document.getElementById('cartPanel').classList.contains('active') && !document.getElementById('wishlistPanel').classList.contains('active')) {
        document.body.style.overflow = '';
    }
  }

  function filterCategory(cat, btn) {
    currentCategory = cat;
    document.querySelectorAll('.cat-chip').forEach(c => c.classList.remove('active'));
    btn.classList.add('active');
    renderProducts();
  }

  function addToCart(id) {
    const product = products.find(p => p.id === id);
    const existing = cart.find(item => item.id === id);
    if (existing) existing.qty++;
    else cart.push({ ...product, qty: 1 });
    updateCart();
    showToast(`✦ ${product.name} added to cart`);
  }

  function updateCart() {
    const countEl = document.getElementById('cartCount');
    const itemsEl = document.getElementById('cartItems');
    const totalEl = document.getElementById('cartTotal');
    const checkoutBtn = document.getElementById('checkoutBtn');

    const totalQty = cart.reduce((sum, item) => sum + item.qty, 0);
    countEl.textContent = totalQty;

    if (cart.length === 0) {
      itemsEl.innerHTML = `<div class="panel-empty"><div class="panel-empty-icon">🛍️</div><p>Your cart is empty</p></div>`;
      totalEl.textContent = '₱0';
      checkoutBtn.disabled = true;
      return;
    }

    itemsEl.innerHTML = cart.map(item => `
      <div class="panel-item">
        <img class="panel-item-img" src="${item.img}" alt="${item.name}" onerror="this.style.display='none'">
        <div class="panel-item-info">
          <div class="panel-item-name">${item.name}</div>
          <div class="panel-item-price">₱${(item.price * item.qty).toLocaleString()}</div>
          <div class="qty-controls">
            <button class="qty-btn" onclick="changeQty(${item.id}, -1)">−</button>
            <span class="qty-num">${item.qty}</span>
            <button class="qty-btn" onclick="changeQty(${item.id}, 1)">+</button>
          </div>
        </div>
        <button class="remove-btn" onclick="removeItem(${item.id})">✕</button>
      </div>
    `).join('');

    const total = cart.reduce((sum, item) => sum + item.price * item.qty, 0);
    totalEl.textContent = `₱${total.toLocaleString()}`;
    checkoutBtn.disabled = false;
  }

  function changeQty(id, delta) {
    const item = cart.find(i => i.id === id);
    if (!item) return;
    item.qty += delta;
    if (item.qty <= 0) cart = cart.filter(i => i.id !== id);
    updateCart();
  }

  function removeItem(id) {
    cart = cart.filter(i => i.id !== id);
    updateCart();
  }

  function openCart() {
    document.getElementById('cartOverlay').classList.add('active');
    document.getElementById('cartPanel').classList.add('active');
    document.body.style.overflow = 'hidden';
  }
  function closeCart() {
    document.getElementById('cartOverlay').classList.remove('active');
    document.getElementById('cartPanel').classList.remove('active');
    if(!document.getElementById('modalOverlay').classList.contains('active') && !document.getElementById('wishlistPanel').classList.contains('active')) {
        document.body.style.overflow = '';
    }
  }

  function toggleMenu() {
    document.getElementById('mobileMenu').classList.toggle('active');
    document.getElementById('mobileOverlay').classList.toggle('active');
    document.getElementById('hamburger').classList.toggle('active');
  }
  function closeMenu() {
    document.getElementById('mobileMenu').classList.remove('active');
    document.getElementById('mobileOverlay').classList.remove('active');
    document.getElementById('hamburger').classList.remove('active');
  }

  function setActive(section) {
    document.querySelectorAll('.nav-link').forEach(link => {
      link.classList.toggle('active', link.dataset.section === section);
    });
    document.querySelectorAll('.mobile-link').forEach(link => {
      link.classList.toggle('active', link.dataset.section === section);
    });
  }

  function handleScroll() {
    const sections = ['home', 'flash', 'bestsellers', 'products', 'contact'];
    const scrollPos = window.scrollY + 140;
    for (let i = sections.length - 1; i >= 0; i--) {
      const el = document.getElementById(sections[i]);
      if (el && el.offsetTop <= scrollPos) {
        setActive(sections[i]);
        break;
      }
    }
  }

  function checkout() {
    if (cart.length === 0) return;
    const total = cart.reduce((sum, item) => sum + item.price * item.qty, 0);
    alert(`✦ Order Confirmed\n\nTotal: ₱${total.toLocaleString()}\n\nThank you for shopping with Havenly! 🛍️`);
    cart = [];
    updateCart();
    closeCart();
  }

  let toastTimer;
  function showToast(message) {
    const toast = document.getElementById('toast');
    toast.textContent = message;
    toast.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => toast.classList.remove('show'), 2200);
  }

  function startCountdown() {
    const endTime = new Date().getTime() + (24 * 60 * 60 * 1000);
    function update() {
      const now = new Date().getTime();
      const diff = endTime - now;
      if (diff <= 0) {
        document.getElementById('countdown').innerHTML = '<div style="font-weight:700;">Sale ended!</div>';
        return;
      }
      const h = Math.floor(diff / (1000 * 60 * 60));
      const m = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
      const s = Math.floor((diff % (1000 * 60)) / 1000);
      document.getElementById('cdHours').textContent = String(h).padStart(2, '0');
      document.getElementById('cdMins').textContent = String(m).padStart(2, '0');
      document.getElementById('cdSecs').textContent = String(s).padStart(2, '0');
    }
    update();
    setInterval(update, 1000);
  }

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

  document.querySelectorAll('a[href^="#"]').forEach(link => {
    link.addEventListener('click', function(e) {
      const targetId = this.getAttribute('href');
      if (targetId === '#') return;
      const target = document.querySelector(targetId);
      if (target) {
        e.preventDefault();
        target.scrollIntoView({ behavior: 'smooth' });
        closeMenu();
      }
    });
  });

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      closeModal();
      closeCart();
      closeWishlist();
      closeMenu();
    }
  });

  // =========================================
  // SMART CHATBOT LOGIC
  // =========================================
  const chatWindow = document.getElementById('chatWindow');
  const chatBody = document.getElementById('chatBody');
  const chatInput = document.getElementById('chatInput');

  function toggleChat() {
    chatWindow.classList.toggle('active');
    if (chatWindow.classList.contains('active')) {
      setTimeout(() => chatInput.focus(), 300);
    }
  }

  function handleChatEnter(e) {
    if (e.key === 'Enter') {
      sendChatMessage();
    }
  }

  function sendChatMessage() {
    const text = chatInput.value.trim();
    if (!text) return;

    // Ipakita ang user message
    appendMessage('user', text);
    chatInput.value = '';

    // Magpakita ng typing indicator
    const typingId = 'typing-' + Date.now();
    chatBody.innerHTML += `
      <div class="chat-msg bot" id="${typingId}">
        <div class="typing-indicator">
          <div class="typing-dot"></div><div class="typing-dot"></div><div class="typing-dot"></div>
        </div>
      </div>`;
    chatBody.scrollTop = chatBody.scrollHeight;

    // Mag-reply pagkatapos ng 1 segundo (parang nag-iisip)
    setTimeout(() => {
      document.getElementById(typingId)?.remove();
      const reply = getBotReply(text);
      appendMessage('bot', reply);
    }, 1000);
  }

  function appendMessage(sender, text) {
    const msgDiv = document.createElement('div');
    msgDiv.className = `chat-msg ${sender}`;
    msgDiv.innerHTML = `<div class="msg-bubble">${text}</div>`;
    chatBody.appendChild(msgDiv);
    chatBody.scrollTop = chatBody.scrollHeight;
  }

  // ANG "UTAK" NG BOT (Rule-based responses)
  function getBotReply(input) {
    const text = input.toLowerCase();

    // 1. Mga Pagbati (Greetings)
    if (text.match(/\b(hi|hello|hey|kumusta|kamusta|good morning|good afternoon)\b/)) {
      return "Kumusta! 👋 Ako si Havenly Assistant. Paano kita matutulungan ngayon? Pwede kang magtanong tungkol sa shipping, presyo, o mga products.";
    }

    // 2. Shipping & Delivery
    if (text.match(/\b(shipping|delivery|deliver|padala|tagal|how long|free)\b/)) {
      return "🚚 **Shipping Info:**<br>• Libre ang shipping sa orders na ₱1,500 pataas!<br>• Karaniwang 1-3 days ang delivery sa Metro Manila, at 3-5 days sa probinsya.<br>• Maaari mong i-track ang order mo via email.";
    }

    // 3. Returns & Refunds
    if (text.match(/\b(return|refund|sira|damage|palit|bawi)\b/)) {
      return "🔄 **Returns & Refunds:**<br>May 30-day return policy kami! Kung may sira o mali ang natanggap mong item, pwede mo itong ibalik o palitan. Bisitahin lang ang Contact page para makipag-ugnayan.";
    }

    // 4. Payment Methods
    if (text.match(/\b(payment|bayad|gcash|maya|card|credit|bank|paypal|cod)\b/)) {
      return "💳 **Payment Options:**<br>Tumatanggap kami ng GCash, Maya, Credit/Debit Cards (Visa/Mastercard), at Cash on Delivery (COD) para sa mga order na taga-Metro Manila.";
    }

    // 5. Presyo / Price
    if (text.match(/\b(price|magkano|presyo|how much|cost|mahal|mura)\b/)) {
      return "💰 Ang aming mga produkto ay nagsisimula sa ₱149 hanggang ₱1,299. Pwede mong i-scroll pababa sa 'All Products' section para makita ang buong listahan at presyo. May Flash Sale din kami ngayon!";
    }

    // 6. Wishlist
    if (text.match(/\b(wishlist|favorite|paborito|heart|save)\b/)) {
      return "❤️ Para i-save ang isang produkto, i-tap lang ang puso (🤍) sa taas-kanan ng product card. Makikita mo lahat ng naka-save sa pamamagitan ng pag-tap sa ❤️ icon sa navigation bar.";
    }

    // 7. Location / Contact
    if (text.match(/\b(location|address|saan|where|contact|email|phone|number)\b/)) {
      return "📍 **Makipag-ugnayan:**<br>Address: 123 Rizal Ave, Manila<br>Email: hello@havenly.ph<br>Phone: +63 912 345 6789<br>Bukas kami Mon-Sat, 8AM-8PM.";
    }

    // 8. Legit / Trust
    if (text.match(/\b(legit|scam|trust|safe|totoong|peke)\b/)) {
      return "✅ **100% Legit at Secure!**<br>Ligtas ang iyong payment information. Kami ay isang curated home essentials shop na nagbebenta lamang ng quality products. Marami na kaming masasayang customers!";
    }

    // 9. Sales / Discounts
    if (text.match(/\b(sale|discount|promo|flash|voucher|bawas)\b/)) {
      return "⚡ **Flash Sale Alert!**<br>May hanggang 40% OFF kami ngayon! Bisitahin ang 'Flash Sale' section para sa mga deals na malapit nang mag-expire. Sumali rin sa aming Newsletter para sa 10% off code!";
    }

    // 10. Default / Fallback
    return "Pasensya na, hindi ko masyadong naintindihan. 🤖 Pero pwede mo akong tanungin tungkol sa: <br>• Shipping & Delivery<br>• Payment Methods<br>• Returns & Refunds<br>• Presyo ng Products<br>• Contact Info";
  }

  // ===== INIT =====
  window.addEventListener('scroll', handleScroll);
  refreshAll();
  updateCart();
  setActive('home');
  startCountdown();

</script>

</body>
</html>
